{
  "name": "@agent-easy-use/mobile-easy-use",
  "version": "0.1.2",
  "description": "Agent-oriented Android and iOS runtime automation through MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-easy-use/mobile-easy-use.git"
  },
  "homepage": "https://github.com/agent-easy-use/mobile-easy-use",
  "type": "module",
  "files": [
    "src",
    "sdk/dist",
    "sdk/android/index.d.ts",
    "sdk/ios/index.d.ts",
    "README.md"
  ],
  "bin": {
    "mobile-easy-use": "src/index.js"
  },
  "scripts": {
    "build": "npm run build:android && npm run build:ios && npm run build:ios-runner",
    "build:android": "frida-compile sdk/android/index.js -o sdk/dist/android.js -S",
    "build:ios": "frida-compile sdk/ios/index.js -o sdk/dist/ios.js -S",
    "build:ios-runner": "frida-compile sdk/runners/ios-xctest-driver.js -o sdk/dist/ios-xctest-driver.js -S",
    "prepack": "npm run build",
    "prestart": "npm run build",
    "start": "node src/index.js",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules --test"
  },
  "dependencies": {
    "@types/frida-gum": "18.7.2",
    "frida": "17.16.4",
    "frida-java-bridge": "^7.0.12",
    "frida-objc-bridge": "8.0.6"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "frida-compile": "^16.4.1"
  }
}

#!/usr/bin/env bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  echo "Usage:"
  echo "  mobile-easy-use-ios load --device NAME --bundle-id ID [--timeout SECONDS]"
  echo "  mobile-easy-use-ios load --simulator NAME_OR_UDID --bundle-id ID [--timeout SECONDS]"
  echo "  mobile-easy-use-ios runner --device UDID --team TEAM_ID [--port PORT]"
  echo "  mobile-easy-use-ios runner --simulator UDID [--port PORT]"
}

case "${1:-}" in
  load)
    shift
    exec "${script_dir}/../Scripts/load-mobile-easy-use.sh" "$@"
    ;;
  runner)
    shift
    exec "${script_dir}/../../../runners/ios-xctest/scripts/serve.sh" "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "Unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac

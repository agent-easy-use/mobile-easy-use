<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="M"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="HelloWorld"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_logout"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_small_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/logout"
                android:textColor="@color/brand_blue_dark"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_welcome_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/home_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#B8CCFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/welcome_message"
                android:textColor="#E5ECFF"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="@string/runtime_overview" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_blue"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sample_actions"
                    android:textColor="@color/brand_blue_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/counter_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="128dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_metric_green"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/evidence_types"
                    android:textColor="@color/success_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UI · State · Chain"
                    android:textColor="@color/success_dark"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/counter_increment"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="@null"
            android:text="@string/run_sample_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView style="@style/SectionTitle" android:text="@string/workspace_capabilities" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/advanced_inspection_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/advanced_inspection_description"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/advanced_inspection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/advanced_inspection_status_disabled"
                android:textColor="@color/brand_blue_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/advanced_inspection_action"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_small_button"
                android:backgroundTint="@null"
                android:text="@string/advanced_inspection_refresh"
                android:textAllCaps="false"
                android:textColor="@color/brand_blue_dark"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="@string/skill_workflows" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <LinearLayout style="@style/FeatureRow">
                <TextView style="@style/FeatureIcon" android:text="&lt;/&gt;" />
                <LinearLayout style="@style/FeatureCopy">
                    <TextView style="@style/FeatureTitle" android:text="@string/skill_generate_title" />
                    <TextView style="@style/FeatureBody" android:text="@string/skill_generate_body" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <LinearLayout style="@style/FeatureRow">
                <TextView style="@style/FeatureIcon" android:text="▶" />
                <LinearLayout style="@style/FeatureCopy">
                    <TextView style="@style/FeatureTitle" android:text="@string/skill_probe_title" />
                    <TextView style="@style/FeatureBody" android:text="@string/skill_probe_body" />
                </LinearLayout>
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <LinearLayout style="@style/FeatureRow">
                <TextView style="@style/FeatureIcon" android:text="◆" />
                <LinearLayout style="@style/FeatureCopy">
                    <TextView style="@style/FeatureTitle" android:text="@string/skill_presets_title" />
                    <TextView style="@style/FeatureBody" android:text="@string/skill_presets_body" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SectionTitle" android:text="@string/mcp_tools" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="@string/mcp_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
                <TextView style="@style/ToolChip" android:text="connect" />
                <TextView style="@style/ToolChip" android:layout_marginStart="8dp" android:text="call_function" />
                <TextView style="@style/ToolChip" android:layout_marginStart="8dp" android:text="disconnect" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
